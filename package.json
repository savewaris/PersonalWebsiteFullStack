{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "verify": "tsc --noEmit && next build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "agent:doctor": "node scripts/agent-doctor.mjs",
    "agent:state": "node scripts/agent-state.mjs",
    "agent:issues": "node scripts/create-github-issues.mjs",
    "audit": "node scripts/gap-audit.mjs",
    "docs:dev": "vitepress dev docs --port 3001",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 3001",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "framer-motion": "^13.4.0",
    "next": "16.3.5",
    "posthog-js": "^1.434.7",
    "react": "19.3.0",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "mermaid": "^12.0.0",
    "prisma": "^6.19.3",
    "typescript": "^6",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
