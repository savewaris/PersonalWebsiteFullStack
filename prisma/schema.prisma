generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  proficiency Int      // 0-100
  category    String   // e.g., "Frontend", "Backend", "Tools"
  icon        String?  // Class name or SVG string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  demoUrl     String?
  repoUrl     String?
  tags        String   // JSON string or comma-separated tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(uuid())
  role        String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime? // Null means "Present"
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id           String   @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String
  faculty      String?  // e.g. "Faculty of ICT"
  startDate    DateTime
  endDate      DateTime?
  score        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Hobby {
  id          String   @id @default(uuid())
  name        String
  emoji       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Interest {
  id          String   @id @default(uuid())
  name        String
  emoji       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Language {
  id          String   @id @default(uuid())
  name        String
  proficiency String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   // e.g., "GitHub", "LinkedIn", "Instagram", "X", "Email", "Discord", "YouTube"
  url       String   // e.g., "https://github.com/savewaris"
  icon      String?  // Optional custom emoji or icon class
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
